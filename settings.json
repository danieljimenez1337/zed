{
  "show_edit_predictions": false,
  "assistant": {
    "default_model": {
      "provider": "openai",
      "model": "gpt-4o"
    },
    "version": "2"
  },
  "tab_size": 2,
  "base_keymap": "VSCode",
  "theme": {
    "mode": "system",
    "dark": "Gruvbox Dark",
    "light": "Gruvbox Light Soft"
  },
  "buffer_font_family": "CommitMono",
  "restore_on_startup": "last_session",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": true,
  "ui_font_size": 17,
  "buffer_font_size": 20.0,
  "show_wrap_guides": true,
  "wrap_guides": [100],
  "format_on_save": "off",
  "vim": {
    "use_multiline_find": true,
    "use_smartcase_find": true
  },
  "relative_line_numbers": true,
  "vertical_scroll_margin": 8,
  "scrollbar": {
    "show": "never"
  },
  "terminal": {
    "line_height": {
      "custom": 1
    }
  },
  "languages": {
    "Ruby": {
      "language_servers": ["solargraph", "rubocop", "!ruby-lsp"],
      "format_on_save": "off"
    },
    "TypeScript": {
      "format_on_save": "off"
    },
    "TSX": {
      "format_on_save": "off"
    },
    "JavaScript": {
      "format_on_save": "off"
    },
    "Java": {
      "enable_language_server": false
    }
  },
  "lsp": {
    // "ruby-lsp": {
    //   "initialization_options": {
    //     "enabledFeatures": {
    //       // This disables diagnostics
    //       "diagnostics": false
    //     }
    //   }
    // },
    "rubocop": {
      "settings": {
        "use_bundler": false
      }
    },
    "solargraph": {
      "settings": {
        "use_bundler": false
      }
    }
  },
  "pane_split_direction_vertical": "right",
  "diagnostics": {
    "include_warnings": true,
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 0,
      "max_severity": null
    }
  }
}
